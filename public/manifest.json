{
  "manifest_version": 3,
  "name": "网站部-小工具",
  "version": "1.0.0",
  "description": "网站部-小工具，支持WordPress、Shopify和图片尺寸检查",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "index.html",
    "default_icon": "icons/logo.png"
  },
  "icons": {
    "48": "icons/logo.png",
    "128": "icons/logo.png"
  },
  "background": {
    "service_worker": "./assets/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["./assets/content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/inject.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
